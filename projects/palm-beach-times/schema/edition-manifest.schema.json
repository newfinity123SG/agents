{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Palm Beach Times v6 edition manifest",
  "description": "Full editorial output contract. This is an input validation structure, not a content generator. All fields are required. Source-backed original images, charts and stories must be produced independently.",
  "type": "object",
  "additionalProperties": false,
  "required": ["MASTHEAD","DATE","DATE_ISO","EDITION","REGION_LABEL","DESK_LABEL","MASTHEAD_LOGO","DECK","CONTENTS_LINKS","TODAYS_THREAD","FRONT_PAGE","MORNING_BRIEFS","WEATHER_OCEAN_DESK","DAILY_JOKE_TILE","MARKET_CHARTS","MARKET_DRIVERS","MONEY_DESK","AROUND_TOWN_DESK","DEVELOPMENT_DESK","LOCAL_NEWS_DESK","COMMUNITY_ISSUES_DESK","AI_TECHNOLOGY_DESK","WORLD_LIFESTYLE_DESK","COMIC_TILE","RESTAURANT_OPENINGS_TILE","SCREEN_GUIDE_TILE","EXTRAS_TILE","FOOTER"],
  "properties": {
    "MASTHEAD":{"type":"string","minLength":1},
    "DATE":{"type":"string","minLength":1},
    "DATE_ISO":{"type":"string","format":"date"},
    "EDITION":{"type":"string","minLength":1},
    "REGION_LABEL":{"type":"string","minLength":1},
    "DESK_LABEL":{"type":"string","minLength":1},
    "MASTHEAD_LOGO":{"type":"string","pattern":"data-masthead-source="},
    "DECK":{"type":"string","minLength":1},
    "CONTENTS_LINKS":{"type":"string","minLength":1},
    "TODAYS_THREAD":{"type":"string","minLength":1},
    "FRONT_PAGE":{"type":"string","minLength":1},
    "MORNING_BRIEFS":{"type":"string","minLength":1},
    "WEATHER_OCEAN_DESK":{"type":"string","minLength":1},
    "DAILY_JOKE_TILE":{"type":"string","minLength":1},
    "MARKET_CHARTS":{"type":"string","minLength":1},
    "MARKET_DRIVERS":{"type":"string","minLength":1},
    "MONEY_DESK":{"type":"string","minLength":1},
    "AROUND_TOWN_DESK":{"type":"string","minLength":1},
    "DEVELOPMENT_DESK":{"type":"string","minLength":1},
    "LOCAL_NEWS_DESK":{"type":"string","minLength":1},
    "COMMUNITY_ISSUES_DESK":{"type":"string","minLength":1},
    "AI_TECHNOLOGY_DESK":{"type":"string","minLength":1},
    "WORLD_LIFESTYLE_DESK":{"type":"string","minLength":1},
    "COMIC_TILE":{"type":"string","pattern":"data-comic-source="},
    "RESTAURANT_OPENINGS_TILE":{"type":"string","minLength":1},
    "SCREEN_GUIDE_TILE":{"type":"string","minLength":1},
    "EXTRAS_TILE":{"type":"string","minLength":1},
    "FOOTER":{"type":"string","minLength":1}
  }
}