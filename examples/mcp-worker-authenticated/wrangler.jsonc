{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "palm-beach-times-mcp",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "keep_vars": true,
  "vars": {
    "ALLOWED_GITHUB_LOGIN": "newfinity123SG"
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/mcp",
      "/authorize",
      "/callback",
      "/oauth/*",
      "/.well-known/*"
    ]
  },
  "services": [
    {
      "binding": "PUBLISHER",
      "service": "palm-beach-times-publisher"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "791af3c84f224d2686c48c2186c8dfbc"
    }
  ]
}
